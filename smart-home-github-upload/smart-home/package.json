{
  "name": "smart-home",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run server\" \"npm run dev --prefix client\"",
    "server": "node --watch server/index.js",
    "build": "npm run build --prefix client",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^8.3.8"
  }
}
